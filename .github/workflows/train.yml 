name: ev-ultra-v3
on:
  workflow_dispatch:

jobs:
  train:
    runs-on: ubuntu-latest
    timeout-minutes: 360
    steps:
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install libraries
        run: pip install -q kaggle pandas numpy scikit-learn lightgbm xgboost catboost category_encoders

      - name: Download data
        env:
          KAGGLE_USERNAME: ${{ secrets.KAGGLE_USERNAME }}
          KAGGLE_KEY: ${{ secrets.KAGGLE_KEY }}
        run: |
          kaggle competitions download -c playground-series-s6e9
          unzip -q playground-series-s6e9.zip

      - name: Create training script
        run: |
          cat > train_submit.py << 'PYEOF'
          import os, gc, time
          import numpy as np
          import pandas as pd
          from sklearn.model_selection import StratifiedKFold
          from sklearn.metrics import roc_auc_score
          from sklearn.preprocessing import LabelEncoder
          from sklearn.cluster import KMeans
          from sklearn.ensemble import HistGradientBoostingClassifier
          from category_encoders import TargetEncoder
          import lightgbm as lgb, xgboost as xgb, catboost as cb
          import warnings; warnings.filterwarnings('ignore')

          train = pd.read_csv('train.csv'); test = pd.read_csv('test.csv')
          y = train['Will_Buy_EV'].map({'Yes':1,'No':0})
          for col in ['Home_Charging_Possible','Subsidy_Available']:
              train[col] = train[col].map({'Yes':1,'No':0}).fillna(0).astype(int)
              test[col]  = test[col].map({'Yes':1,'No':0}).fillna(0).astype(int)

          def feats(df):
              inc = df['Annual_Income_USD'].astype(float); age = df['Age'].astype(float)
              hc = df['Home_Charging_Possible'].astype(int); sb = df['Subsidy_Available'].astype(int)
              sth = df['Charging_Stations_Near_Home'].astype(float); stw = df['Charging_Stations_Near_Work'].astype(float)
              cm = df['Daily_Commute_km'].astype(float)
              df['Income_LT_31004'] = (inc < 31004).astype(int)
              df['Income_50_100'] = ((inc>=50000)&(inc<100000)).astype(int)
              df['Income_100_170'] = ((inc>=100000)&(inc<=170537)).astype(int)
              df['High_Income'] = (inc > 170537).astype(int)
              df['HC_x_St_Home'] = hc*sth; df['NoHC_x_St_Home'] = (1-hc)*sth
              df['HC_x_St_Work'] = hc*stw; df['NoHC_x_St_Work'] = (1-hc)*stw
              df['Total_Stations'] = sth+stw; df['Station_Ratio'] = sth/(stw+1)
              df['LowInc_Sub'] = df['Income_LT_31004']*sb
              df['HighInc_Sub'] = df['High_Income']*sb
              df['HC_Sub_LowInc'] = hc*sb*df['Income_LT_31004']
              df['St_HC_Sub'] = df['Total_Stations']*hc*sb
              df['Inc_Age'] = inc/(age+1); df['Inc_Log'] = np.log1p(inc.clip(lower=0))
              df['Inc_Car'] = inc/(df['Number_of_Cars_Owned'].astype(float)+1)
              df['Commute_Inc'] = cm/(inc+1); df['Stations_Commute'] = df['Total_Stations']/(cm+1)
              for c in ['Annual_Income_USD','Age','Daily_Commute_km','Charging_Stations_Near_Home']:
                  s = df[c].abs()
                  for k in range(4): df[f'{c}_d{k}'] = (s // (10**k)) % 10
                  df[f'{c}_last'] = s % 10
                  df[f'{c}_dsum'] = s.astype(int).astype(str).apply(lambda t: sum(int(ch) for ch in t))
              return df

          fr = [c for c in train.columns if c not in ['id','Will_Buy_EV']]
          X = feats(train[fr].copy()); Xt = feats(test[fr].copy())
          for col in ['Gender','City_Type','Current_Car_Type','Range_Anxiety_Level']:
              if col in X.columns:
                  le = LabelEncoder(); le.fit(pd.concat([X[col].astype(str), Xt[col].astype(str)]))
                  X[col] = le.transform(X[col].astype(str)); Xt[col] = le.transform(Xt[col].astype(str))
          tec = [c for c in ['Gender','City_Type','Current_Car_Type'] if c in X.columns]
          te = TargetEncoder(cols=tec, smoothing=10)
          X = pd.concat([X, te.fit_transform(X[tec], y).add_suffix('_te')], axis=1)
          Xt = pd.concat([Xt, te.transform(Xt[tec]).add_suffix('_te')], axis=1)
          nc = X.select_dtypes(include=[np.number]).columns
          for k in [5,10]:
              km = KMeans(n_clusters=k, random_state=42, n_init=3, max_iter=100)
              X[f'cluster_{k}'] = km.fit_predict(X[nc].fillna(0)); Xt[f'cluster_{k}'] = km.predict(Xt[nc].fillna(0))
          X = X.fillna(0); Xt = Xt.fillna(0)
          for df in [X, Xt]:
              for c in df.columns:
                  if df[c].dtype == 'float64': df[c] = df[c].astype(np.float32)
          print(f'features: {X.shape[1]}')

          def rank_avg(pl):
              r = [pd.Series(p).rank().values for p in pl]
              return np.mean(r, axis=0)/(len(r[0])+1)

          ao = {m: [] for m in ['lgb','xgb','cat','hgb']}; at = {m: [] for m in ao}
          for seed in [42, 1337, 2024]:
              skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=seed)
              so = {m: np.zeros(len(X)) for m in ao}; st = {m: np.zeros(len(Xt)) for m in ao}
              for tr_i, va_i in skf.split(X, y):
                  Xtr, Xva, ytr, yva = X.iloc[tr_i], X.iloc[va_i], y.iloc[tr_i], y.iloc[va_i]
                  m = lgb.train({'objective':'binary','metric':'auc','num_leaves':127,'learning_rate':0.03,
                      'max_depth':10,'min_child_samples':20,'feature_fraction':0.8,'bagging_fraction':0.8,
                      'bagging_freq':5,'lambda_l1':0.1,'lambda_l2':1.0,'verbose':-1,'seed':seed},
                      lgb.Dataset(Xtr, label=ytr), num_boost_round=1000,
                      valid_sets=[lgb.Dataset(Xva, label=yva)],
                      callbacks=[lgb.early_stopping(100, verbose=False), lgb.log_evaluation(0)])
                  so['lgb'][va_i] = m.predict(Xva); st['lgb'] += m.predict(Xt)/5; del m; gc.collect()
                  m = xgb.XGBClassifier(n_estimators=1000, learning_rate=0.03, max_depth=10, subsample=0.8,
                      colsample_bytree=0.8, reg_alpha=0.1, reg_lambda=1.0, random_state=seed, verbosity=0,
                      n_jobs=-1, tree_method='hist', early_stopping_rounds=100)
                  m.fit(Xtr, ytr, eval_set=[(Xva, yva)], verbose=False)
                  so['xgb'][va_i] = m.predict_proba(Xva)[:,1]; st['xgb'] += m.predict_proba(Xt)[:,1]/5; del m; gc.collect()
                  m = cb.CatBoostClassifier(iterations=1000, learning_rate=0.03, depth=10, l2_leaf_reg=1.0,
                      random_state=seed, verbose=False, thread_count=4)
                  m.fit(Xtr, ytr, eval_set=[(Xva, yva)], early_stopping_rounds=100, verbose=False)
                  so['cat'][va_i] = m.predict_proba(Xva)[:,1]; st['cat'] += m.predict_proba(Xt)[:,1]/5; del m; gc.collect()
                  m = HistGradientBoostingClassifier(max_iter=1000, learning_rate=0.03, max_depth=10,
                      min_samples_leaf=20, l2_regularization=1.0, random_state=seed, verbose=0)
                  m.fit(Xtr, ytr)
                  so['hgb'][va_i] = m.predict_proba(Xva)[:,1]; st['hgb'] += m.predict_proba(Xt)[:,1]/5; del m; gc.collect()
              for mm in ao: ao[mm].append(so[mm]); at[mm].append(st[mm])
              print({mm: round(roc_auc_score(y, so[mm]),6) for mm in so}, flush=True)

          fo = {m: rank_avg(ao[m]) for m in ao}; ft = {m: rank_avg(at[m]) for m in ao}
          cvs = {m: roc_auc_score(y, fo[m]) for m in fo}
          order = sorted(cvs, key=cvs.get); w = {m:(i+1) for i,m in enumerate(order)}; tw = sum(w.values())
          w = {m:v/tw for m,v in w.items()}
          ens_o = sum(w[m]*fo[m] for m in w); ens_t = sum(w[m]*ft[m] for m in w)
          cv = roc_auc_score(y, ens_o)
          print(f'FINAL CV: {cv:.6f}', flush=True)

          sub = pd.DataFrame({'id': test['id'], 'Will_Buy_EV': ens_t})
          sub.to_csv('submission_ultra_v3.csv', index=False)
          from kaggle.api.kaggle_api_extended import KaggleApi
          api = KaggleApi(); api.authenticate()
          api.competition_submit('submission_ultra_v3.csv',
              message=f'GH-Actions Ultra v3 CV {cv:.5f}', competition='playground-series-s6e9', quiet=True)
          print('SUBMITTED OK', flush=True)
          PYEOF

      - name: Train and submit
        env:
          KAGGLE_USERNAME: ${{ secrets.KAGGLE_USERNAME }}
          KAGGLE_KEY: ${{ secrets.KAGGLE_KEY }}
        run: python train_submit.py

      - name: Upload submission artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: submission-ultra-v3
          path: submission_ultra_v3.csv
